{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rota 10A Jogos Fora data file",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "season",
    "matches",
    "places"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "project": {
      "const": "Rota 10A — Jogos Fora"
    },
    "season": {
      "type": "string"
    },
    "last_updated": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "season",
          "date",
          "home_team",
          "away_team",
          "destination",
          "place_ids"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "season": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "kickoff_local": {
            "type": [
              "string",
              "null"
            ]
          },
          "home_team": {
            "type": "string"
          },
          "away_team": {
            "type": "string"
          },
          "destination": {
            "type": "string"
          },
          "venue": {
            "type": [
              "string",
              "null"
            ]
          },
          "venue_status": {
            "type": "string"
          },
          "fixture_status": {
            "type": "string"
          },
          "place_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "route": {
            "type": "object"
          },
          "access_information": {
            "type": "object"
          }
        }
      }
    },
    "places": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "region",
          "editorial_context",
          "sources",
          "editorial_experience",
          "supporter_suitability"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "editorial_context": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "summary": {
            "type": "string"
          },
          "source_status": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "label",
                "url"
              ]
            }
          },
          "editorial_experience": {
            "type": "object"
          },
          "supporter_suitability": {
            "type": "object"
          },
          "last_verified": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          }
        }
      }
    }
  }
}
